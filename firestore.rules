rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Fase 1: no hay colecciones reales todavía. Todo bloqueado por defecto
    // para no dejar la base abierta mientras se define el resto.
    // Cada colección real (ventas, inventario, gastos, etc.) va a tener
    // su propia regla explícita cuando la construyamos.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
