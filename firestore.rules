rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function estaAutenticado() {
      return request.auth != null;
    }
    function miId() {
      // El correo interno es id@evejeans.local -> el id es la parte antes del @
      return request.auth.token.email.split('@')[0];
    }
    function esNelson() {
      return estaAutenticado() && miId() == 'nelson';
    }

    // ---------- Inventario ----------
    // Cualquiera autenticado puede leer el stock (así se ve en vivo en la pantalla de vender).
    // Las vendedoras SOLO pueden mover el número de stock (sube al devolver en un cambio,
    // baja al vender), nunca tocar el nombre o el precio. Nelson puede todo.
    //
    // OJO: como los cambios todavía no están vinculados a la venta original (se decidió así
    // a propósito por ahora), esta regla no puede verificar que una subida de stock corresponda
    // a un cambio real —  solo evita que se toquen nombre/precio o que el stock quede negativo.
    // Cerrar ese hueco del todo requiere Cloud Functions (plan Blaze), pendiente para más adelante.
    match /inventario/{itemId} {
      allow read: if estaAutenticado();
      allow create, delete: if esNelson();
      allow update: if esNelson()
                    || (
                      estaAutenticado()
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
                      && request.resource.data.stock is number
                      && request.resource.data.stock >= 0
                    );
    }

    // ---------- Contador del consecutivo de ventas ----------
    // Solo se puede leer y actualizar (nunca crear ni borrar) desde una venta real.
    match /contadores/{contadorId} {
      allow get: if estaAutenticado();
      allow update: if estaAutenticado()
                    && request.resource.data.ultimo == resource.data.ultimo + 1;
      allow create, delete: if esNelson();
    }

    // ---------- Ventas ----------
    match /ventas/{ventaId} {
      allow read: if estaAutenticado();

      // Crear una venta: el número debe coincidir con el contador,
      // el usuario debe ser quien dice ser, y nace sin anular.
      allow create: if estaAutenticado()
                    && request.resource.data.usuarioId == miId()
                    && request.resource.data.anulada == false
                    && request.resource.data.total is number
                    && request.resource.data.total >= 0;

      // Una venta ya creada nunca la edita ni la borra una vendedora.
      // Solo Nelson puede (por ejemplo, para borrar ventas de prueba antes de arrancar en serio,
      // o para el flujo de "anular" cuando lo construyamos en la Fase 3).
      allow update, delete: if esNelson();
    }
    // ---------- Configuración general (comisiones, etc.) ----------
    // Cualquiera autenticado puede leerla (la necesita el formulario de gastos
    // para calcular la comisión en vivo). Solo Nelson la edita.
    match /config/{configId} {
      allow read: if estaAutenticado();
      allow write: if esNelson();
    }

    // ---------- Gastos ----------
    match /gastos/{gastoId} {
      allow read: if estaAutenticado();

      allow create: if estaAutenticado()
                    && request.resource.data.usuarioId == miId()
                    && request.resource.data.anulado == false
                    && request.resource.data.monto is number
                    && request.resource.data.monto >= 0;

      // "Anular" es el único cambio permitido después de creado: de vivo a anulado,
      // con motivo y quién lo hizo. Nunca se reactiva, nunca se borra, nunca se edita el monto.
      allow update: if estaAutenticado()
                    && resource.data.anulado == false
                    && request.resource.data.anulado == true
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['anulado', 'motivoAnulacion', 'anuladoPor']);
      allow delete: if false;
    }

    // ---------- Cierres del día ----------
    match /cierres/{cierreId} {
      allow read: if estaAutenticado();
      allow create: if estaAutenticado()
                    && request.resource.data.usuarioId == miId()
                    && request.resource.data.contado is number
                    && request.resource.data.contado >= 0;
      // Solo Nelson puede tocar un cierre ya hecho (por ejemplo, para marcarlo "entregado"
      // cuando construyamos los sobres, o para limpiar cierres de prueba).
      allow update, delete: if esNelson();
    }
  }
}
